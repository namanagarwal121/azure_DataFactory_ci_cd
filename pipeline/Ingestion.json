							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n    'select max(last_updated) as cdc_timestamp from ',\n    pipeline().parameters.schema,\n    '.',\n    pipeline().parameters.table\n)",
											"type": "Expression"
